# Copy this file to .env.local and fill in the values

# Convex — get from https://dashboard.convex.dev after running: pnpm convex dev
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com (optional for dev, required for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# UjumbeSMS — https://ujumbesms.co.ke
UJUMBESMS_API_KEY=
UJUMBESMS_EMAIL=

# No Mapbox token needed — OpenFreeMap tiles are 100% free

# IntaSend (Phase 2 billing — not required for hackathon demo)
INTASEND_PUBLIC_KEY=
INTASEND_SECRET_KEY=
